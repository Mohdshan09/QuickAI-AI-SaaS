{
  "rewrites": [
    {
      "source": "/examsnap",
      "destination": "https://exam-snap-drab.vercel.app/examsnap"
    },
    {
      "source": "/examsnap/(.*)",
      "destination": "https://exam-snap-drab.vercel.app/examsnap/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}