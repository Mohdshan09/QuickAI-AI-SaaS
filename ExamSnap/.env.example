# ExamSnap environment variables.
#
# Build-time (sitemap base URL; plain Node, not exposed to the client):
SITE_URL=https://quickai.com/examsnap

# Backend (server-only — NEVER prefix with VITE_, never commit real values).
# Put real values in .env.local (gitignored) for local dev, and in the ExamSnap Vercel
# project's Environment Variables for production.

# Neon Postgres connection string (from the Neon dashboard).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret salt used only to hash IPs for rate limiting (any long random string).
RATE_LIMIT_SALT=change-me-to-a-long-random-string
