# ExamSnap environment variables.
#
# Where the app is published. Drives the Vite base path, every canonical/Open Graph URL, the
# sitemap and robots.txt. Use the bare origin for a domain root, or include a path when the app
# is mounted in a subfolder (https://example.com/examsnap). Build-time only, but public anyway.
SITE_URL=https://exam-snap-drab.vercel.app/examsnap

# Backend (server-only — NEVER prefix with VITE_, never commit real values).
# Put real values in .env.local (gitignored) for local dev, and in the ExamSnap Vercel
# project's Environment Variables for production.

# Neon Postgres connection string (from the Neon dashboard).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret salt used only to hash IPs for rate limiting (any long random string).
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# Admin email for the /analytics page (simple gate; kept server-side, not in the client bundle).
ADMIN_EMAIL=

# Shared secret for the private admin pages — /moderation (comments) and /admin/specs (spec
# review queue). The page sends it as the x-moderation-key header; it is never bundled.
MODERATION_KEY=change-me-to-a-long-random-string
