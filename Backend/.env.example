# Server
PORT=3000

# Neon Postgres connection string
DB_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk (read automatically by @clerk/express)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Signing secret for the Clerk webhook endpoint (POST /api/webhooks/clerk).
# From the Clerk Dashboard -> Webhooks -> your endpoint. Read automatically by
# verifyWebhook. In dev, expose the endpoint with a tunnel (e.g. ngrok).
CLERK_WEBHOOK_SIGNING_SECRET=

# Google Gemini (used via the OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_api_key

# ClipDrop (text-to-image)
clipDrop_API_KEY=your_clipdrop_api_key

# Cloudinary
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# Abuse protection for AI endpoints
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=50
AI_GLOBAL_DAILY_LIMIT=1000

# Admin module: comma-separated emails granted super_admin on first sign-in.
# Their Clerk publicMetadata.role is set to super_admin automatically.
ADMIN_BOOTSTRAP_EMAILS=

# Credits (Phase 2): credits granted once when a user's wallet is first created.
INITIAL_CREDIT_GRANT=3

# AI credit consumption (Phase 3). Timeout after which an AI call is treated as
# failed (and the pre-charged credits refunded). Per-service credit costs are
# optional overrides of the defaults in config/aiCredits.js.
AI_REQUEST_TIMEOUT_MS=60000
# AI_CREDIT_COST_MATCH_ANALYSIS=2
# AI_CREDIT_COST_RESUME_OPTIMIZATION=3
