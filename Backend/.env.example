# Server
PORT=3000

# Neon Postgres connection string
DB_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk (read automatically by @clerk/express)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Google Gemini (used via the OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_api_key

# ClipDrop (text-to-image)
clipDrop_API_KEY=your_clipdrop_api_key

# Cloudinary
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# Abuse protection for AI endpoints
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=50
AI_GLOBAL_DAILY_LIMIT=1000
